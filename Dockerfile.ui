FROM python:3.11-slim

ARG GIT_COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_COMMIT_SHA

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true

WORKDIR /app
COPY requirements-ui.txt .
RUN python -m pip install --no-cache-dir -r requirements-ui.txt
COPY incidentiq ./incidentiq
RUN cd /tmp && python -c "import incidentiq.ui"

EXPOSE 8501
CMD ["sh", "-c", "exec streamlit run incidentiq/ui.py --server.address 0.0.0.0 --server.port ${PORT:-8501}"]
